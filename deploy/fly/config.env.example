# Copy to deploy/fly/config.env for local use. This file contains only public
# deployment settings. FLY_API_TOKEN stays in the repository-root .env or the
# process environment; the age private identity stays under deploy/fly/.state.

FLY_ORG=sbol
FLY_APP=sbol-db-production
FLY_PRIMARY_REGION=ord

# This must be a custom hostname controlled by the operator. SBOL DB performs
# its own ACME TLS-ALPN-01 challenge over raw TCP 443; *.fly.dev is not valid.
SBOL_DB_HOSTNAME=registry.example.org
SBOL_DB_ACME_CONTACT=ops@example.org

# Globally unique private Tigris bucket and object prefix.
SBOL_DB_BACKUP_BUCKET=sbol-db-production-backups
SBOL_DB_BACKUP_PREFIX=registry/production

# Populate this with `deploy/fly/seed.sh keygen` output.
SBOL_DB_BACKUP_RECOVERY_RECIPIENT=age1replace

FLY_VOLUME_NAME=sbol_db_data
FLY_VOLUME_SIZE_GB=100
FLY_VOLUME_SNAPSHOT_RETENTION_DAYS=14
FLY_VOLUME_AUTO_EXTEND_THRESHOLD=70
FLY_VOLUME_AUTO_EXTEND_INCREMENT_GB=25
FLY_VOLUME_AUTO_EXTEND_LIMIT_GB=500

FLY_VM_SIZE=performance-4x
FLY_VM_MEMORY=16GB
SBOL_DB_MIN_FREE_BYTES=10737418240
SBOL_DB_BACKUP_INTERVAL_SECS=21600

# CI should pass an immutable digest. A full commit tag is accepted for the
# initial deployment when it names the already-published GHCR image.
FLY_IMAGE=ghcr.io/marpaia/sbol-db:replace-with-full-git-sha

# Exact local source that was populated from synbiohub-data.
SBOL_DB_LOCAL_DATA_DIR=/absolute/path/to/sbol-db/.sbol-db
