# Copy to .env and adjust. run-conformance.sh sources this file.

# sbol-db image for the subject services (the container workflow publishes it).
SBOLDB_IMAGE=ghcr.io/marpaia/sbol-db

# Reference (classic SynBioHub) and subject base URLs. Defaults match the host
# ports in docker-compose.yaml.
REFERENCE_URL=http://localhost:17777
SUBJECT_POSTGRES_URL=http://localhost:18902
SUBJECT_SQLITE_URL=http://localhost:18903
SUBJECT_ROCKSDB_URL=http://localhost:18904

# Semantic SBOL comparison oracle (used by compare_sbol_via_validator).
VALIDATOR_URL=https://validator.sbolstandard.org/validate/

# Corpus of SBOL2 RDF/XML files seeded into both sides.
CORPUS=~/git/SynBioHub/synbiohub/tests/Emulated
